	column TATcorr≥30 =
			
			VAR _v = SAP_cerrados[TAT Corridos]
			RETURN
			IF( NOT ISBLANK(_v) && _v >= 30, 1, 0 )
		formatString: 0
		lineageTag: 7396bba3-0ed6-4b1c-b5cb-235b2b4d370e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 1stVisitRes =
			
			VAR _visita = SAP_cerrados[Fecha Visita]
			VAR _fin    = SAP_cerrados[Fecha Cierre]
			RETURN
			IF(
			    NOT ISBLANK(_visita) &&
			    NOT ISBLANK(_fin) &&
			    _fin >= _visita &&
			    DATEDIFF(_visita, _fin, DAY) <= 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 47811c74-ab2b-4264-a02f-e313e158c099
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Service Type' =
			
			IF(
			    SAP_cerrados[Clase de Aviso] = "ZM",
			    "Carry In",
			    "In Home"
			)
		lineageTag: 99bea7a4-0314-4e5b-8715-10db654d7cec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Service Type QTY' = ```
			
			1
			
			```
		formatString: 0
		lineageTag: ae2b0464-5d9b-40df-b66c-175690e9d274
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Visita Técnica Válida' =
			
			VAR f = SAP_cerrados[Falla 1]
			RETURN
			IF (
			    f IN {
			        "Anulación",
			        "Anulado",
			        "Anulado/cliente no lleva equipo",
			        "Anulacion de reapertura",
			        "Cliente ausente (sin visita)",
			        "Datos incorrectos",
			        "Error de carga / repetición de reclamo",
			        "Aviso Duplicado"
			    },
			    0,   -- EXCLUIR
			    1    -- INCLUIR (hubo visita técnica)
			)
		formatString: 0
		lineageTag: a23a27da-e994-4b09-ad64-3101d9e94800
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Falla 1'
		dataType: string
		lineageTag: 5c49a751-c57f-48df-843c-eb61b05fe98a
		summarizeBy: none
		sourceColumn: Falla 1

		annotation SummarizationSetBy = Automatic

	column Geolocalizacion =
			
			VAR Localidad = TRIM( SAP_cerrados[Localidad cliente] )
			VAR Provincia = TRIM( SAP_cerrados[Provincia del Cliente] )
			VAR Pais = "Argentina"
			RETURN
			IF(
			    NOT ISBLANK(Localidad) && NOT ISBLANK(Provincia),
			    Localidad & ", " & Provincia & ", " & Pais,
			    BLANK()
			)
		lineageTag: 566bcd30-e46e-4b6d-a50d-03c059772434
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Season =
			
			VAR Fecha = 'SAP_cerrados'[Fecha Cierre]
			VAR AnioInicio =
			    IF (
			        MONTH ( Fecha ) >= 4,
			        YEAR ( Fecha ),
			        YEAR ( Fecha ) - 1
			    )
			RETURN
			    AnioInicio & "-" & ( AnioInicio + 1 )
		lineageTag: b4a8763e-dac1-438d-80ad-04ff6ba13ed0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition SAP_cerrados = m
		mode: import
		source =
				let
				    // ============ 0) Parámetros ============
				    SiteUrl     = "https://mideacarrierjv.sharepoint.com/sites/ARGARANTIAS",
				    LibraryName = "Documentos Compartilhados",
				    FolderLvl1  = "REPO_PBI_BD",
				    FolderLvl2  = "RTAT",
				    FolderLvl3  = "Cerrados",
				
				    // ============ 1) Navegación SharePoint robusta ============
				    Root    = SharePoint.Contents(SiteUrl, [ApiVersion=15]),
				    Library = Root{[Name=LibraryName]}[Content],
				    TryLvl1 = try Library{[Name=FolderLvl1]}[Content],
				    Lvl1    = if TryLvl1[HasError]
				              then (Library{[Name="General"]}[Content]){[Name=FolderLvl1]}[Content]
				              else TryLvl1[Value],
				    Lvl2        = Lvl1{[Name=FolderLvl2]}[Content],
				    FinalFolder = Lvl2{[Name=FolderLvl3]}[Content],
				
				    // ============ 2) Filtrar archivos ============
				    SoloExcel  = Table.SelectRows(FinalFolder, each Text.EndsWith(Text.Lower([Name]), ".xlsx")),
				    SinOcultos = Table.SelectRows(SoloExcel, each [Attributes]?[Hidden]? <> true),
				    Files      = Table.SelectColumns(SinOcultos, {"Name", "Content"}),
				
				    // ============ 3) Invocar helper y expandir (mecanismo idéntico a M1) ============
				    #"Invocar función personalizada1"  = Table.AddColumn(Files, "Transformar archivo (2)", each #"Transformar archivo (2)"([Content])),
				    #"Otras columnas quitadas1"        = Table.SelectColumns(#"Invocar función personalizada1", {"Name", "Transformar archivo (2)"}),
				    #"Columna de tabla expandida1"     = Table.ExpandTableColumn(
				                                             #"Otras columnas quitadas1",
				                                             "Transformar archivo (2)",
				                                             Table.ColumnNames(#"Transformar archivo (2)"(#"Archivo de ejemplo (2)"))
				                                         ),
				
				    // ============ 4) Tipos ============
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Columna de tabla expandida1",
				        {
				            {"Fecha", type date},                                   {"Usuario", type text},
				            {"Clase de Aviso", type text},                          {"N° de Aviso", Int64.Type},
				            {"N° de Ticket(CallCenter Chile)", type text},          {"Fecha Visita", type date},
				            {"Fecha Cierre", type date},                            {"N° de Serie", type text},
				            {"Modelo", type text},                                  {"Descripcion Material", type text},
				            {"N° de Factura", type text},                           {"Fecha Fact.", type date},
				            {"Puesto de Trabajo", type text},                       {"Centro de Servicio", type text},
				            {"Cliente", Int64.Type},                                {"Razon Social", type text},
				            {"Comuna", type text},                                  {"Nombre del Cliente", type text},
				            {"Rut del Cliente", type any},                          {"Dir. del Cliente", type text},
				            {"Comuna Cliente", type text},                          {"Teléfono 1 del Cliente", type text},
				            {"KM", Int64.Type},                                     {"N° de Orden", Int64.Type},
				            {"Texto", type text},                                   {"Estado", type text},
				            {"Tarifa Plan", Int64.Type},                            {"Tarifa Real", Int64.Type},
				            {"Falla", type text},                                   {"Reingreso (avisos con ser.y mod.repetido", type text},
				            {"Tiempo1(Creacion-Visita)", Int64.Type},               {"Tiempo2(Creacion-Cierre)", Int64.Type},
				            {"Usuario de Creación", type text},                     {"Cod.Falla 1", type text},
				            {"Falla 1", type text},                                 {"Cod.Falla 2", type text},
				            {"Falla 2", type text},                                 {"Cod.Falla 3", type text},
				            {"Falla 3", type text},                                 {"Correo", type text},
				            {"Teléfono 2 del Cliente", type text},                  {"Provincia del Cliente", type text}
				        }
				    ),
				
				    // ============ 5) Eliminar filas basura (N° de Aviso null) ============
				    SinBasura = Table.SelectRows(#"Tipo cambiado", each [#"N° de Aviso"] <> null),
				
				    // ============ 6) Columnas quitadas ============
				    #"Columnas quitadas" = Table.RemoveColumns(
				        SinBasura,
				        {
				            "Usuario", "N° de Ticket(CallCenter Chile)", "Comuna", "Rut del Cliente",
				            "Reingreso (avisos con ser.y mod.repetido", "Tiempo1(Creacion-Visita)", "Tiempo2(Creacion-Cierre)",
				            "Usuario de Creación", "Cod.Falla 1", "Cod.Falla 2", "Falla 2", "Cod.Falla 3", "Falla 3"
				        }
				    ),
				
				    // ============ 7) Renombres ============
				    #"Columnas con nombre cambiado" = Table.RenameColumns(
				        #"Columnas quitadas",
				        {
				            {"Fecha",          "Fecha Inicio"},
				            {"Cliente",        "Nro. Cte. Comercio"},
				            {"Razon Social",   "Comercio"},
				            {"Comuna Cliente", "Localidad cliente"}
				        },
				        MissingField.Ignore
				    ),
				
				    // ============ 8) Reordenado final ============
				    #"Columnas reordenadas" = Table.ReorderColumns(
				        #"Columnas con nombre cambiado",
				        {
				            "Name",
				            "Clase de Aviso","N° de Aviso","Fecha Inicio","Fecha Visita","Fecha Cierre",
				            "N° de Serie","Modelo","Descripcion Material","N° de Factura","Fecha Fact.",
				            "Puesto de Trabajo","Centro de Servicio","Nro. Cte. Comercio","Comercio",
				            "Nombre del Cliente","Dir. del Cliente","Provincia del Cliente","Localidad cliente",
				            "Teléfono 1 del Cliente","Teléfono 2 del Cliente","KM","N° de Orden",
				            "Texto","Estado","Tarifa Plan","Tarifa Real","Falla","Correo"
				        },
				        MissingField.Ignore
				    )
				in
				    #"Columnas reordenadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

