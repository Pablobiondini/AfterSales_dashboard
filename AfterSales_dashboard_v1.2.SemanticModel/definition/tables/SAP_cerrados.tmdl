	column 'FechaDesde TAT' = ```
			
			VAR _clase  = SAP_cerrados[Clase de Aviso]
			VAR _visita = SAP_cerrados[Fecha Visita]
			VAR _inicio = SAP_cerrados[Fecha Inicio]
			RETURN
			IF ( _clase = "ZM" && NOT ISBLANK ( _visita ), _visita, _inicio )
			
			```
		formatString: d/m/yyyy
		lineageTag: f78378ab-7c38-4cc4-9221-761d9186705c
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 0eec009f-248a-4af1-a9ec-172dc7665c12
			defaultHierarchy: LocalDateTable_a8870b33-aba7-450d-8ade-be30eef6ee98.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'TAT Laboral' = ```
			
			VAR _desde = SAP_cerrados[FechaDesde TAT]
			VAR _fin   = SAP_cerrados[Fecha Cierre]
			RETURN
			IF (
			    ISBLANK ( _desde ) || ISBLANK ( _fin ) || _fin < _desde,
			    BLANK(),
			    VAR _idx_fin   = LOOKUPVALUE ( DimFecha[BIndex Laborable], DimFecha[Date], _fin )
			    VAR _idx_desde = LOOKUPVALUE ( DimFecha[BIndex Laborable], DimFecha[Date], _desde )
			    VAR _raw       = _idx_fin - _idx_desde   -- SIN restar 1 extra
			    RETURN IF ( _raw >= 0, _raw, 0 )
			)
			
			```
		formatString: 0
		lineageTag: 6d83e472-b8f2-439f-9531-affd88eb85dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'TAT Corridos' = ```
			
			VAR _desde = SAP_cerrados[FechaDesde TAT]   -- usa la misma lógica ZM/Visita
			VAR _fin   = SAP_cerrados[Fecha Cierre]
			RETURN
			IF (
			    ISBLANK(_desde) || ISBLANK(_fin) || _fin < _desde,
			    BLANK(),
			    DATEDIFF(_desde, _fin, DAY)   -- excluye el día de inicio, incluye el de cierre
			)
			
			```
		formatString: 0
		lineageTag: e415e149-b2d9-4b60-b7ca-7b874e58ca03
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Con Repuesto' = ```
			
			VAR _t = TRIM( LOWER( SAP_cerrados[Texto] ) )
			RETURN
			IF(
			    _t = "" || _t = "m",
			    0,
			    1
			)
			
			```
		formatString: 0
		lineageTag: 649c206b-67db-40d6-b4f4-2f5fc75de83d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ConRepuestoTXT = IF(SAP_cerrados[Con Repuesto]=1, "Con Repuesto", "Sin repuesto")
		lineageTag: 410db17e-ef92-4620-a19f-0f395b0743e1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'En Radio' =
			
			VAR _rawTxt =
			    TRIM(
			        SUBSTITUTE(
			            SUBSTITUTE(
			                SUBSTITUTE( SAP_cerrados[KM] & "", UNICHAR(160), " " ),
			                ".",
			                ""
			            ),
			            ",",
			            "."
			        )
			    )
			VAR _kmNum = IFERROR( VALUE(_rawTxt), BLANK() )
			RETURN
			IF(
			    ISBLANK(_kmNum) || _kmNum <= 50,
			    "SI",
			    "NO"
			)
		lineageTag: a15dbbdd-0f0e-4a69-bfc0-ac53d8373381
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

