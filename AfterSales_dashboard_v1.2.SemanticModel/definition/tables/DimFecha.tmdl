	column EsFinDeSemana
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: f35a4619-dcd0-40f3-84b3-281c9729e841
		summarizeBy: none
		isNameInferred
		sourceColumn: [EsFinDeSemana]

		annotation SummarizationSetBy = Automatic

	column EsFeriado =
			
			IF(
			    CONTAINS( DimFeriados, DimFeriados[FechaFeriado], DimFecha[Date] ),
			    TRUE(),
			    FALSE()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: bc8aad82-8a9e-48d3-bcff-b5f95964c5ee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EsLaborable =
			
			IF(
			    DimFecha[EsFeriado] = TRUE()
			        || DimFecha[EsFinDeSemana] = TRUE(),
			    FALSE(),
			    TRUE()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 4899bc10-4ad0-4ab8-8c99-4cd2cab8c557
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'EsLaborable Num' = ```
			
			IF ( DimFecha[EsLaborable], 1, 0 )
			
			```
		formatString: 0
		lineageTag: 74e4d2d5-6085-49a9-bb6b-a8fa397618f3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'BIndex Laborable' = ```
			
			VAR _fecha = DimFecha[Date]
			RETURN
			CALCULATE(
			    SUM ( DimFecha[EsLaborable Num] ),
			    FILTER ( ALL ( DimFecha ), DimFecha[Date] <= _fecha )
			)
			
			```
		formatString: 0
		lineageTag: 8026887a-00aa-49f9-bc5f-85d2cac997aa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimFecha = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR (DATE(2020,1,1), DATE(2030,12,31)),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MM"),
				    "Mes Nombre", FORMAT([Date], "MMMM"),
				    "Año-Mes", FORMAT([Date], "YYYY-MM"),
				    "Día", DAY([Date]),
				    "DiaSemanaNum", WEEKDAY([Date], 2),      -- 1=lunes, 7=domingo (modo 2)
				    "DiaSemanaNombre", FORMAT([Date], "dddd"),
				    "EsFinDeSemana", IF(WEEKDAY([Date],2) >= 6, TRUE(), FALSE())
				)
				
				```

	annotation PBI_Id = 0b878f3cfc04445897abc27f9930346c

